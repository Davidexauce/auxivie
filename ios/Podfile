# Uncomment this line to define a global platform for your project
platform :ios, '14.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  inhibit_all_warnings!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  # Requis par StripePaymentSheet (CardScanningView) sur certaines versions
  pod 'StripeCardScan'
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # Forcer le deployment target minimum à 14.0 pour tous les pods
      if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 14.0
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '14.0'
      end
      
      # Optimisations pour compilation plus rapide en mode Debug
      if config.name == 'Debug'
        config.build_settings['ONLY_ACTIVE_ARCH'] = 'YES'
        config.build_settings['SWIFT_OPTIMIZATION_LEVEL'] = '-Onone'
        config.build_settings['GCC_OPTIMIZATION_LEVEL'] = '0'
        config.build_settings['SWIFT_COMPILATION_MODE'] = 'singlefile'
        config.build_settings['COMPILER_INDEX_STORE_ENABLE'] = 'YES'
        # Réduire le bruit Xcode provenant des pods externes
        config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
      end

      # Réduire les alertes issues des dépendances tierces (Pods)
      config.build_settings['SWIFT_SUPPRESS_WARNINGS'] = 'YES'
      config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
      config.build_settings['RUN_CLANG_STATIC_ANALYZER'] = 'NO'
    end
  end

  # Patch StripePaymentSheet: désactive le "scan de carte" (STPCardScanner)
  # car certaines versions Stripe/Xcode ne l'exposent plus, ce qui empêche le build Release/Archive.
  # CocoaPods installe les fichiers en lecture seule — chmod requis avant toute écriture.
  patch_pod_file = lambda do |path, &block|
    next unless File.exist?(path)

    File.chmod(0o644, path)
    content = File.read(path)
    new_content = block.call(content)
    next if new_content == content

    File.write(path, new_content)
    File.chmod(0o444, path)
  end

  begin
    pod_root = File.dirname(__FILE__)
    stripe_ps = File.join(pod_root, 'Pods', 'StripePaymentSheet', 'StripePaymentSheet', 'StripePaymentSheet', 'Source', 'PaymentSheet')

    patch_pod_file.call(File.join(stripe_ps, 'Elements', 'CardSection', 'CardSectionElement.swift')) do |content|
      next content unless content.include?('STPCardScanner') || content.include?('CardSectionWithScannerView')

      content = content.gsub(/lazy var view: UIView = \{[\s\S]*?\}\(\)/m, "lazy var view: UIView = {\n        return cardSection.view\n    }()")
      content.sub(
        "#if !os(visionOS)\n// MARK: - CardSectionWithScannerViewDelegate",
        "#if false\n// MARK: - CardSectionWithScannerViewDelegate"
      )
    end

    patch_pod_file.call(File.join(stripe_ps, 'Views', 'CardScanningView.swift')) do |content|
      next content if content.include?("#if false\n")

      content.sub("#if !os(visionOS)", '#if false')
    end

    patch_pod_file.call(File.join(stripe_ps, 'Elements', 'CardSection', 'CardSectionWithScannerView.swift')) do |content|
      next content if content.include?("#if false\n")

      content.sub("#if !os(visionOS)", '#if false')
    end
  rescue => e
    puts "⚠️ post_install Stripe patch skipped: #{e}"
  end
end
